DirectoryIndex index.html
ErrorDocument 404 /404.html

# Lojas pelo subdomínio (nome.araujotechsistemas.com): a página inicial usa o catálogo genérico (catalogo.php = 404.html + nome e logo da loja para a prévia do link), não o do Fogão Mineiro
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} \.araujotechsistemas\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^(www\.)?fogaomineiro\.araujotechsistemas\.com$ [NC]
  RewriteRule ^(index\.html)?$ /catalogo.php [L]
  # painel do local no subdomínio: nome e logo da própria loja no título, no histórico e no atalho da tela de início
  RewriteCond %{HTTP_HOST} \.araujotechsistemas\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^(www\.)?fogaomineiro\.araujotechsistemas\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^painel/(index\.html)?$ /painel.php [L]
  RewriteCond %{HTTP_HOST} \.araujotechsistemas\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^(www\.)?fogaomineiro\.araujotechsistemas\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^painel/manifest\.json$ /painel_manifest.php [L]
  # ícones do navegador nos subdomínios dos clientes: o logo da própria loja (sem logo: símbolo da Vitrix), nunca o do Fogão Mineiro
  RewriteCond %{HTTP_HOST} \.araujotechsistemas\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^(www\.)?fogaomineiro\.araujotechsistemas\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(favicon\.png|favicon\.ico|icon-192\.png|icon-512\.png|apple-touch-icon(-precomposed)?\.png)$ /logo.php?s=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
