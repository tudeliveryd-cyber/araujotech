rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email in ['admin@araujotechsistemas.com'];
    }
    function isShop(shop) {
      return signedIn()
        && exists(/databases/$(database)/documents/shopUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/shopUsers/$(request.auth.uid)).data.shop == shop;
    }
    // dono do local (funcionários têm role caja, cocina ou mozo)
    function isOwner(shop) {
      return isShop(shop)
        && get(/databases/$(database)/documents/shopUsers/$(request.auth.uid)).data.get('role', 'dono') == 'dono';
    }
    // Agenda: miembro (dueño o profesional) y dueño
    function agMember(ag) {
      return signedIn()
        && exists(/databases/$(database)/documents/agendaUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/agendaUsers/$(request.auth.uid)).data.ag == ag;
    }
    function agOwner(ag) {
      return agMember(ag)
        && get(/databases/$(database)/documents/agendaUsers/$(request.auth.uid)).data.role == 'owner';
    }
    // campos que só o administrador muda
    function same(f) { return request.resource.data.get(f, null) == resource.data.get(f, null); }
    function siteSame(f) { return request.resource.data.get('site', {}).get(f, null) == resource.data.get('site', {}).get(f, null); }
    // função do funcionário dentro do local ('dono' quando não há campo role)
    function shopRole() {
      return get(/databases/$(database)/documents/shopUsers/$(request.auth.uid)).data.get('role', 'dono');
    }
    // v11: o local existe e não está suspenso (pedidos de fora só entram em loja no ar)
    function shopLive(shop) {
      return exists(/databases/$(database)/documents/shops/$(shop))
        && get(/databases/$(database)/documents/shops/$(shop)).data.get('status', 'ativo') != 'suspenso';
    }
    // v11: tipos dos campos de um pedido (campos ausentes ou nulos são aceitos)
    function numOk(d, k) { return !(k in d) || d[k] == null || d[k] is number; }
    function strOk(d, k, n) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= n); }
    function okOrder(d) {
      return d.size() <= 48
        && (!('lines' in d) || (d.lines is list && d.lines.size() <= 80))
        && (!('items' in d) || (d.items is list && d.items.size() <= 80))
        && (!('no' in d) || d.no is int)
        && numOk(d, 'total') && numOk(d, 'sub') && numOk(d, 'fee') && numOk(d, 'disc')
        && strOk(d, 'name', 120) && strOk(d, 'phone', 40) && strOk(d, 'status', 20)
        && strOk(d, 'mode', 20) && strOk(d, 'pay', 20) && strOk(d, 'msg', 8000)
        && (!('proof' in d) || d.proof == null
            || (d.proof is string && d.proof.size() <= 1000000
                && d.proof.matches('^data:image/(jpeg|png|webp);base64,.*')));
    }
    function noAdminFields() {
      return !('feeApproved' in request.resource.data) && !('status' in request.resource.data)
        && !('lim' in request.resource.data) && !('site' in request.resource.data);
    }

    // conteúdo do site araujotechsistemas.com (editado no admin): leitura pública
    match /platform/sitio { allow read: if true; allow write: if isAdmin(); }
    match /platform/{doc} { allow read, write: if isAdmin(); }
    match /billing/{id}   { allow read, write: if isAdmin(); }
    // licença dos sistemas (Agenda, Caja…): o sistema lê se está ativo ou suspenso; só o admin muda
    match /licencias/{id} { allow read: if true; allow write: if isAdmin(); }

    // contador de visitas do site: qualquer um só pode somar 1; só o admin lê
    match /visitas/{dia} {
      allow read: if isAdmin();
      allow create: if dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['n', 'u'])
        && request.resource.data.n == 1 && request.resource.data.u in [0, 1];
      allow update: if request.resource.data.keys().hasOnly(['n', 'u'])
        && request.resource.data.n == resource.data.n + 1
        && (request.resource.data.u == resource.data.u || request.resource.data.u == resource.data.u + 1);
    }
    // v13: contatos pelo WhatsApp a partir do site (wa) e das demonstrações (demo): qualquer um só soma 1 em um dos dois; só o admin lê
    function cliqueMais1(k) {
      return request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1;
    }
    function cliqueIgual(k) {
      return request.resource.data.get(k, 0) == resource.data.get(k, 0);
    }
    match /cliques/{dia} {
      allow read: if isAdmin();
      allow create: if dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['wa', 'demo'])
        && request.resource.data.size() == 1
        && (request.resource.data.get('wa', 0) == 1 || request.resource.data.get('demo', 0) == 1);
      allow update: if request.resource.data.keys().hasOnly(['wa', 'demo'])
        && ((cliqueMais1('wa') && cliqueIgual('demo')) || (cliqueMais1('demo') && cliqueIgual('wa')));
    }


    match /shopUsers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid)
        || (signedIn() && isOwner(resource.data.shop));
      allow create: if isAdmin()
        || (isOwner(request.resource.data.shop)
            && request.resource.data.role in ['caja', 'cocina', 'mozo']
            && request.resource.data.keys().hasOnly(['shop', 'email', 'role', 'mc']));
      allow delete: if isAdmin()
        || (isOwner(resource.data.shop) && resource.data.get('role', 'dono') in ['caja', 'cocina', 'mozo']);
      // a própria pessoa só pode marcar que já trocou a senha provisória
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mc'])
            && request.resource.data.mc == false);
    }

    // ===== Agenda para salones y barberías =====
    match /agendaUsers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid)
        || (signedIn() && agOwner(resource.data.ag));
      allow create: if isAdmin()
        || (agOwner(request.resource.data.ag)
            && request.resource.data.role == 'pro'
            && request.resource.data.keys().hasOnly(['ag', 'email', 'role', 'proId', 'name', 'mc']));
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mc'])
            && request.resource.data.mc == false);
      allow delete: if isAdmin() || (agOwner(resource.data.ag) && resource.data.role == 'pro');
    }
    // página pública de reservas
    match /agendaPub/{ag} {
      allow read: if true;
      allow write: if isAdmin() || agMember(ag);
    }
    match /agendas/{ag} {
      match /state/{d} {
        allow read, write: if isAdmin() || agMember(ag);
      }
      // logo, portada, fotos y fotos del equipo (públicas, se ven en la página de reservas)
      match /img/{h} {
        allow read: if true;
        allow write: if isAdmin() || agMember(ag);
      }
      // reservas online: cualquiera crea, con tamaño limitado; solo el negocio lee y marca
      match /reservas/{r} {
        allow create: if request.resource.data.keys().hasOnly(['json', 'at', 'p'])
          && request.resource.data.json is string && request.resource.data.json.size() <= 6000
          && request.resource.data.p == false
          && (!exists(/databases/$(database)/documents/licencias/$(ag))
              || get(/databases/$(database)/documents/licencias/$(ag)).data.get('status', 'activo') != 'suspenso');
        allow read, update, delete: if isAdmin() || agMember(ag);
      }
    }

    match /shops/{shop} {
      allow read: if true;
      allow create: if isAdmin() || (isShop(shop) && noAdminFields());
      allow update: if isAdmin()
        || (isShop(shop) && shopRole() != 'cocina'
            && same('feeApproved') && same('status') && same('lim')
            && siteSame('on') && siteSame('slug'));
      allow delete: if isAdmin();

      // dados privados do dono (custo dos produtos): só o dono e o admin leem e escrevem
      match /priv/{d} {
        allow read, write: if isAdmin() || isOwner(shop);
      }
      match /media/{pack} {
        allow read: if true;
        allow write: if isAdmin() || (isShop(shop) && shopRole() != 'cocina');
      }
      match /meta/{m} {
        allow read: if true;
        allow write: if isAdmin() || isShop(shop);
        // contador de pedidos: o catálogo só pode criar em 1 ou somar 1 (ninguém zera a numeração)
        allow create: if m == 'counter' && request.resource.data.keys().hasOnly(['n', 't']) && request.resource.data.n == 1
          && (!('t' in request.resource.data) || request.resource.data.t == request.time);
        allow update: if m == 'counter' && request.resource.data.keys().hasOnly(['n', 't'])
          && request.resource.data.n == resource.data.n + 1
          && (!('t' in request.resource.data) || request.resource.data.t == request.time || request.resource.data.t == resource.data.get('t', null));
      }
      match /orders/{id} {
        // pedidos e chamados do catálogo: qualquer cliente cria, com tamanho limitado
        allow create: if (isAdmin() || isShop(shop) || shopLive(shop))
          && okOrder(request.resource.data);
        allow read, update: if isAdmin() || isShop(shop);
        allow delete: if isAdmin() || isOwner(shop);
      }
      match /track/{id} {
        allow read: if true;
        allow create: if request.resource.data.size() <= 20
          && (isAdmin() || isShop(shop) || shopLive(shop));
        allow update, delete: if isAdmin() || isShop(shop);
      }
      // opiniões: só de pedidos que existem, uma por pedido
      match /reviews/{rid} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/shops/$(shop)/orders/$(rid))
          && request.resource.data.keys().hasOnly(['stars', 'text', 'name', 'no', 'date'])
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && request.resource.data.text is string && request.resource.data.text.size() <= 400
          && request.resource.data.name is string && request.resource.data.name.size() <= 40;
        allow update, delete: if isAdmin() || isOwner(shop);
      }
    }
  }
}
